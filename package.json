{
  "name": "dsh-ronghuamofang",
  "version": "0.4.1",
  "description": "绒花墨坊（NovelForge）× DSH：在 DSH 里读章、看批注与结构指标、生成改稿候选（只算不落），并在设置里改墨坊地址。采用归作者，插件不代拍。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "novelforge",
    "ronghuamofang"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MUYU46548/dsh-ronghuamofang.git"
  },
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2",
      "dshReleases": {
        "0.2.2-rc.3": "verified",
        "0.2.2-rc.5": "compatible"
      }
    }
  },
  "scripts": {
    "test": "node --test test/http.test.mjs test/settings.test.mjs test/tools.test.mjs test/plugin.test.mjs test/client.test.mjs test/compat.test.mjs test/proof.test.mjs"
  },
  "author": "MUYU46548",
  "license": "MIT"
}
